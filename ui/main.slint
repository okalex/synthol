import { FilterResponseDisplay, AdsrEnvelopePanel, Dropdown, KnobModulation, ModDragHandle, ModRouteRow, ModRouteSlot, PositionMarker, SynthKnob, WaveformDisplay } from "controls.slint";

export { KnobModulation, ModRouteSlot, PositionMarker }

import "JetBrainsMono-Regular.ttf";

component OutputGainSlider inherits Rectangle {
    in-out property <float> value: 1.0;
    in property <string> value-text: "0.0 dB";

    callback pressed();
    callback changed(float);
    callback released();

    height: 50px;

    Text {
        y: 0px;
        horizontal-alignment: left;
        text: "Output Gain";
        font-size: 10px;
        color: #b0b3bd;
    }

    Rectangle {
        x: 8px;
        y: 28px;
        width: parent.width - 68px;
        height: 4px;
        border-radius: 2px;
        background: #343943;
    }

    Rectangle {
        x: 8px;
        y: 28px;
        width: (parent.width - 68px) * root.value;
        height: 4px;
        border-radius: 2px;
        background: #4d99f2;
    }

    Rectangle {
        x: root.value * (parent.width - 68px);
        y: 22px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #e8eaf0;
    }

    Text {
        x: parent.width - 48px;
        y: 20px;
        horizontal-alignment: left;
        text: root.value-text;
        font-size: 10px;
        color: #b0b3bd;
    }

    // Unlike Slint's standard Slider, this drag-only control has no
    // FocusScope: pointer interaction must leave computer-MIDI keys
    // available to the host.
    TouchArea {
        x: 8px;
        y: 16px;
        width: parent.width - 68px;
        height: 28px;
        property <bool> gesture-active: false;

        moved => {
            if self.gesture-active {
                root.value = clamp(self.mouse-x / self.width, 0.0, 1.0);
                root.changed(root.value);
            }
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                self.gesture-active = true;
                root.pressed();
                root.value = clamp(self.mouse-x / self.width, 0.0, 1.0);
                root.changed(root.value);
            } else if self.gesture-active
                    && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                self.gesture-active = false;
                root.released();
            }
        }
    }
}

export component SynthUi inherits Window {
    in-out property <float> gain: 1.0;
    in-out property <string> gain-text: "0.0 dB";
    in-out property <float> attack: 0.251;
    in-out property <float> decay: 0.549;
    in-out property <float> sustain: 0.9;
    in-out property <float> sustain-level: 0.501;
    in-out property <float> release: 0.631;
    in-out property <string> attack-text: "10.0 ms";
    in-out property <string> decay-text: "500.0 ms";
    in-out property <string> sustain-text: "-6.0 dB";
    in-out property <string> release-text: "1000.0 ms";
    in-out property <int> voices: 8;
    in-out property <int> oscillator: 0;
    in-out property <float> phase: 0.0;
    in-out property <string> phase-text: "0.0 °";
    callback gain-pressed();
    callback gain-changed(float);
    callback gain-released();
    callback envelope-pressed(int);
    callback envelope-changed(int, float);
    callback envelope-sustain-level-changed(float);
    callback envelope-released(int);
    callback voices-selected(int);
    callback oscillator-selected(int);
    callback phase-changed(float);
    callback phase-released();
    pure callback oscillator-cycle-path(int, float, float, float) -> string;
    in-out property <float> osc-pitch: 0.5;
    in-out property <string> osc-pitch-text: "+0.00 st";
    in-out property <float> osc-level: 1.0;
    in-out property <string> osc-level-text: "100 %";
    // Parameter id 0 is pitch, 1 is level.
    callback osc-changed(int, float);
    callback osc-released(int);
    in-out property <int> filter-type: 0;
    in-out property <float> filter-cutoff: 1.0;
    in-out property <string> filter-cutoff-text: "20.0 kHz";
    in-out property <float> filter-q: 0.5;
    in-out property <string> filter-q-text: "0.71";
    callback filter-type-selected(int);
    // Parameter id 0 is cutoff, 1 is Q.
    callback filter-changed(int, float);
    callback filter-released(int);
    pure callback filter-response-path(int, float, float, float, float) -> string;
    in-out property <int> lfo-shape: 0;
    in-out property <float> lfo-rate: 0.575;
    in-out property <string> lfo-rate-text: "1.0 Hz";
    in-out property <int> lfo-mode: 0;
    // One marker per voice slot; see `lfo_markers` in editor.rs.
    in-out property <[PositionMarker]> lfo-markers;
    callback lfo-shape-selected(int);
    callback lfo-rate-changed(float);
    callback lfo-rate-released();
    callback lfo-mode-selected(int);
    pure callback lfo-cycle-path(int, float, float) -> string;
    // LFO routing. Destination indices: 0 pitch, 1 level, 2 cutoff, 3 Q.
    // Routing slot destinations add 1, with 0 meaning None.
    in property <[string]> mod-destinations: ["None", "Osc Pitch", "Osc Level", "Filter Cutoff", "Filter Q"];
    in-out property <[ModRouteSlot]> mod-slots;
    // Per destination; see `knob_modulation` in editor.rs.
    in-out property <[KnobModulation]> knob-mods;
    callback mod-assign(int);
    callback mod-destination-selected(int, int);
    callback mod-amount-changed(int, float);
    callback mod-amount-released(int);
    callback mod-remove(int);
    callback mod-depth-changed(int, float);
    callback mod-depth-released(int);

    title: "Synthol";
    preferred-width: 720px;
    preferred-height: 1010px;
    background: #17191f;
    default-font-family: "JetBrains Mono";

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 38px;
            vertical-stretch: 0;
            background: #20232b;

            Text {
                x: 18px;
                y: (parent.height - self.preferred-height) / 2;
                text: "SYNTHOL";
                font-size: 14px;
                font-weight: 700;
                color: #e8eaf0;
            }
        }

        VerticalLayout {
            padding: 18px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 20px;
                alignment: center;

                Text {
                    text: "OUTPUT";
                    font-size: 10px;
                    font-weight: 700;
                    color: #9299a8;
                }

                OutputGainSlider {
                    width: 420px;
                    value <=> root.gain;
                    value-text: root.gain-text;
                    pressed => { root.gain-pressed(); }
                    changed(value) => { root.gain-changed(value); }
                    released => { root.gain-released(); }
                }

                Text {
                    text: "VOICES";
                    font-size: 10px;
                    font-weight: 700;
                    color: #9299a8;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;

                    Dropdown {
                        width: 72px;
                        options: ["Mono", "2", "3", "4", "5", "6", "7", "8"];
                        selected-index: root.voices - 1;
                        selected(index) => { root.voices-selected(index + 1); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                Text {
                    text: "OSCILLATOR";
                    font-size: 10px;
                    font-weight: 700;
                    color: #9299a8;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;

                    Dropdown {
                        options: ["Sine", "Square", "Triangle", "Sawtooth"];
                        selected-index: root.oscillator;
                        selected(index) => { root.oscillator-selected(index); }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    WaveformDisplay {
                        width: 180px;
                        waveform: root.oscillator;
                        phase: root.phase;
                        cycle-path(waveform, phase, width, height) => {
                            return root.oscillator-cycle-path(waveform, phase, width, height);
                        }
                    }
                }

                SynthKnob {
                    value <=> root.phase;
                    label: "PHASE";
                    value-text: root.phase-text;
                    changed(_, value) => { root.phase-changed(value); }
                    released(_) => { root.phase-released(); }
                }

                pitch-knob := SynthKnob {
                    value <=> root.osc-pitch;
                    label: "PITCH";
                    parameter-id: 0;
                    value-text: root.osc-pitch-text;
                    mod-target: 0;
                    modulation: root.knob-mods[0];
                    mod-drag-active: mod-handle.dragging;
                    mod-drag-x: mod-handle.pointer-x;
                    mod-drag-y: mod-handle.pointer-y;
                    changed(id, value) => { root.osc-changed(id, value); }
                    released(id) => { root.osc-released(id); }
                    mod-depth-changed(target, depth) => { root.mod-depth-changed(target, depth); }
                    mod-depth-released(target) => { root.mod-depth-released(target); }
                }

                level-knob := SynthKnob {
                    value <=> root.osc-level;
                    label: "LEVEL";
                    parameter-id: 1;
                    value-text: root.osc-level-text;
                    mod-target: 1;
                    modulation: root.knob-mods[1];
                    mod-drag-active: mod-handle.dragging;
                    mod-drag-x: mod-handle.pointer-x;
                    mod-drag-y: mod-handle.pointer-y;
                    changed(id, value) => { root.osc-changed(id, value); }
                    released(id) => { root.osc-released(id); }
                    mod-depth-changed(target, depth) => { root.mod-depth-changed(target, depth); }
                    mod-depth-released(target) => { root.mod-depth-released(target); }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                Text {
                    text: "FILTER";
                    font-size: 10px;
                    font-weight: 700;
                    color: #9299a8;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;

                    Dropdown {
                        options: ["Low Pass", "High Pass", "Band Pass"];
                        selected-index: root.filter-type;
                        selected(index) => { root.filter-type-selected(index); }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    FilterResponseDisplay {
                        filter-type: root.filter-type;
                        cutoff: root.filter-cutoff;
                        q: root.filter-q;
                        response-path(filter-type, cutoff, q, width, height) => {
                            return root.filter-response-path(filter-type, cutoff, q, width, height);
                        }
                    }
                }

                cutoff-knob := SynthKnob {
                    value <=> root.filter-cutoff;
                    label: "CUTOFF";
                    parameter-id: 0;
                    value-text: root.filter-cutoff-text;
                    mod-target: 2;
                    modulation: root.knob-mods[2];
                    mod-drag-active: mod-handle.dragging;
                    mod-drag-x: mod-handle.pointer-x;
                    mod-drag-y: mod-handle.pointer-y;
                    changed(id, value) => { root.filter-changed(id, value); }
                    released(id) => { root.filter-released(id); }
                    mod-depth-changed(target, depth) => { root.mod-depth-changed(target, depth); }
                    mod-depth-released(target) => { root.mod-depth-released(target); }
                }

                q-knob := SynthKnob {
                    value <=> root.filter-q;
                    label: "Q";
                    parameter-id: 1;
                    value-text: root.filter-q-text;
                    mod-target: 3;
                    modulation: root.knob-mods[3];
                    mod-drag-active: mod-handle.dragging;
                    mod-drag-x: mod-handle.pointer-x;
                    mod-drag-y: mod-handle.pointer-y;
                    changed(id, value) => { root.filter-changed(id, value); }
                    released(id) => { root.filter-released(id); }
                    mod-depth-changed(target, depth) => { root.mod-depth-changed(target, depth); }
                    mod-depth-released(target) => { root.mod-depth-released(target); }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                Text {
                    text: "LFO";
                    font-size: 10px;
                    font-weight: 700;
                    color: #9299a8;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;

                    Dropdown {
                        options: ["Sine", "Square", "Triangle", "Sawtooth"];
                        selected-index: root.lfo-shape;
                        selected(index) => { root.lfo-shape-selected(index); }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    WaveformDisplay {
                        waveform: root.lfo-shape;
                        markers: root.lfo-markers;
                        cycle-path(waveform, _, width, height) => {
                            return root.lfo-cycle-path(waveform, width, height);
                        }
                    }
                }

                SynthKnob {
                    value <=> root.lfo-rate;
                    label: "RATE";
                    value-text: root.lfo-rate-text;
                    changed(_, value) => { root.lfo-rate-changed(value); }
                    released(_) => { root.lfo-rate-released(); }
                }

                Rectangle { width: 16px; }

                Text {
                    text: "MODE";
                    font-size: 10px;
                    font-weight: 700;
                    color: #9299a8;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;

                    Dropdown {
                        width: 88px;
                        options: ["Trigger", "Sync"];
                        selected-index: root.lfo-mode;
                        selected(index) => { root.lfo-mode-selected(index); }
                    }
                }
            }

            VerticalLayout {
                spacing: 8px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Text {
                        text: "LFO ROUTING";
                        font-size: 10px;
                        font-weight: 700;
                        color: #9299a8;
                        vertical-alignment: center;
                    }

                    mod-handle := ModDragHandle {
                        dropped => {
                            if pitch-knob.mod-drop-hover {
                                root.mod-assign(0);
                            } else if level-knob.mod-drop-hover {
                                root.mod-assign(1);
                            } else if cutoff-knob.mod-drop-hover {
                                root.mod-assign(2);
                            } else if q-knob.mod-drop-hover {
                                root.mod-assign(3);
                            }
                        }
                    }

                    Text {
                        text: "Drag onto PITCH, LEVEL, CUTOFF or Q · Alt-drag a knob to set depth · Shift for fine";
                        font-size: 9px;
                        color: #6f7685;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 62px;

                    for slot[index] in root.mod-slots: ModRouteRow {
                        x: (parent.width - 672px) / 2 + mod(index, 2) * 342px;
                        y: floor(index / 2) * 34px;
                        slot: slot;
                        destinations: root.mod-destinations;
                        destination-selected(destination) => { root.mod-destination-selected(index, destination); }
                        amount-changed(amount) => { root.mod-amount-changed(index, amount); }
                        amount-released => { root.mod-amount-released(index); }
                        remove => { root.mod-remove(index); }
                    }
                }
            }

            AdsrEnvelopePanel {
                width: 100%;
                height: 360px;
                attack <=> root.attack;
                decay <=> root.decay;
                sustain <=> root.sustain;
                sustain-level: root.sustain-level;
                release <=> root.release;
                attack-text: root.attack-text;
                decay-text: root.decay-text;
                sustain-text: root.sustain-text;
                release-text: root.release-text;
                pressed(id) => { root.envelope-pressed(id); }
                changed(id, value) => { root.envelope-changed(id, value); }
                sustain-level-changed(value) => { root.envelope-sustain-level-changed(value); }
                released(id) => { root.envelope-released(id); }
            }
        }
    }

    // Follows the pointer while the LFO is dragged onto a knob; drawn last so
    // it sits above everything.
    if mod-handle.dragging: Rectangle {
        x: mod-handle.pointer-x - 7px;
        y: mod-handle.pointer-y - 7px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #f2b84d;
        border-width: 2px;
        border-color: #ffe2a8;
        opacity: 0.85;
    }
}
