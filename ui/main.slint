import { FilterResponseDisplay, AdsrEnvelopePanel, Dropdown, KnobModulation, ModDragHandle, ModRouteRow, ModRouteSlot, PositionMarker, SynthKnob, TabButton, TextButton, WaveformDisplay } from "controls.slint";

export { KnobModulation, ModRouteSlot, PositionMarker }

// One active oscillator's controls, as normalized parameter values.
export struct OscillatorRow {
    waveform: int,
    phase: float,
    phase-text: string,
    pitch: float,
    pitch-text: string,
    level: float,
    level-text: string,
}

import "JetBrainsMono-Regular.ttf";

component OutputGainSlider inherits Rectangle {
    in-out property <float> value: 1.0;
    in property <string> value-text: "0.0 dB";

    callback pressed();
    callback changed(float);
    callback released();

    height: 50px;

    Text {
        y: 0px;
        horizontal-alignment: left;
        text: "Output Gain";
        font-size: 10px;
        color: #b0b3bd;
    }

    Rectangle {
        x: 8px;
        y: 28px;
        width: parent.width - 68px;
        height: 4px;
        border-radius: 2px;
        background: #343943;
    }

    Rectangle {
        x: 8px;
        y: 28px;
        width: (parent.width - 68px) * root.value;
        height: 4px;
        border-radius: 2px;
        background: #4d99f2;
    }

    Rectangle {
        x: root.value * (parent.width - 68px);
        y: 22px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #e8eaf0;
    }

    Text {
        x: parent.width - 48px;
        y: 20px;
        horizontal-alignment: left;
        text: root.value-text;
        font-size: 10px;
        color: #b0b3bd;
    }

    // Unlike Slint's standard Slider, this drag-only control has no
    // FocusScope: pointer interaction must leave computer-MIDI keys
    // available to the host.
    TouchArea {
        x: 8px;
        y: 16px;
        width: parent.width - 68px;
        height: 28px;
        property <bool> gesture-active: false;

        moved => {
            if self.gesture-active {
                root.value = clamp(self.mouse-x / self.width, 0.0, 1.0);
                root.changed(root.value);
            }
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                self.gesture-active = true;
                root.pressed();
                root.value = clamp(self.mouse-x / self.width, 0.0, 1.0);
                root.changed(root.value);
            } else if self.gesture-active
                    && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                self.gesture-active = false;
                root.released();
            }
        }
    }
}

export component SynthUi inherits Window {
    in-out property <float> gain: 1.0;
    in-out property <string> gain-text: "0.0 dB";
    in-out property <float> attack: 0.251;
    in-out property <float> decay: 0.549;
    in-out property <float> sustain: 0.9;
    in-out property <float> sustain-level: 0.501;
    in-out property <float> release: 0.631;
    in-out property <string> attack-text: "10.0 ms";
    in-out property <string> decay-text: "500.0 ms";
    in-out property <string> sustain-text: "-6.0 dB";
    in-out property <string> release-text: "1000.0 ms";
    in-out property <int> voices: 8;
    // The active oscillators; see `oscillator_row` in editor.rs.
    in-out property <[OscillatorRow]> oscillators: [{ waveform: 0, phase: 0.0, phase-text: "0.0 °", pitch: 0.5, pitch-text: "+0.00 st", level: 1.0, level-text: "100 %" }];
    in property <int> max-oscillators: 4;
    // The oscillator tab the user picked; `current-oscillator` keeps it in
    // range while the oscillator list changes.
    in-out property <int> selected-oscillator: 0;
    out property <int> current-oscillator: max(0, min(root.selected-oscillator, root.oscillators.length - 1));
    property <OscillatorRow> current-osc: root.oscillators[root.current-oscillator];
    callback gain-pressed();
    callback gain-changed(float);
    callback gain-released();
    callback envelope-pressed(int);
    callback envelope-changed(int, float);
    callback envelope-sustain-level-changed(float);
    callback envelope-released(int);
    callback voices-selected(int);
    // Oscillator callbacks take the oscillator's index first.
    callback oscillator-selected(int, int);
    pure callback oscillator-cycle-path(int, float, float, float) -> string;
    // Parameter id 0 is pitch, 1 is level, 2 is phase.
    callback osc-changed(int, int, float);
    callback osc-released(int, int);
    callback oscillator-add();
    callback oscillator-remove(int);
    in-out property <int> filter-type: 0;
    in-out property <float> filter-cutoff: 1.0;
    in-out property <string> filter-cutoff-text: "20.0 kHz";
    in-out property <float> filter-q: 0.5;
    in-out property <string> filter-q-text: "0.71";
    in-out property <float> filter-mix: 1.0;
    in-out property <string> filter-mix-text: "100 %";
    callback filter-type-selected(int);
    // Parameter id 0 is cutoff, 1 is Q, 2 is Mix.
    callback filter-changed(int, float);
    callback filter-released(int);
    pure callback filter-response-path(int, float, float, float, float, float) -> string;
    in-out property <int> lfo-shape: 0;
    in-out property <float> lfo-rate: 0.575;
    in-out property <string> lfo-rate-text: "1.0 Hz";
    in-out property <int> lfo-mode: 0;
    in property <int> lfo-count: 0;
    in property <int> max-lfos: 4;
    in-out property <int> selected-lfo: 0;
    out property <int> current-lfo: max(0, min(root.selected-lfo, root.lfo-count - 1));
    callback lfo-add();
    callback lfo-remove(int);
    // One marker per voice slot; see `lfo_markers` in editor.rs.
    in-out property <[PositionMarker]> lfo-markers;
    callback lfo-shape-selected(int);
    callback lfo-rate-changed(float);
    callback lfo-rate-released();
    callback lfo-mode-selected(int);
    pure callback lfo-cycle-path(int, float, float) -> string;
    // LFO routing. Knob destination indices follow `ModDestination::ALL`:
    // oscillator n's pitch is 2n and level 2n + 1, then cutoff and Q after
    // the last oscillator's. Routing slot destinations index
    // `mod-destinations`, which editor.rs fills.
    in property <int> cutoff-mod-target: 2 * root.max-oscillators;
    in property <[string]> mod-destinations: ["None", "Osc 1 Pitch", "Osc 1 Level", "Filter Cutoff", "Filter Q", "Filter Mix"];
    in-out property <[ModRouteSlot]> mod-slots;
    // Per destination; see `knob_modulation` in editor.rs.
    in-out property <[KnobModulation]> knob-mods;
    callback mod-assign(int);
    callback mod-destination-selected(int, int);
    callback mod-amount-changed(int, float);
    callback mod-amount-released(int);
    callback mod-remove(int);
    callback mod-depth-changed(int, float);
    callback mod-depth-released(int);

    title: "Synthol";
    preferred-width: 1100px;
    preferred-height: 1100px;
    background: #17191f;
    default-font-family: "JetBrains Mono";

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 38px;
            vertical-stretch: 0;
            background: #20232b;

            Text {
                x: 18px;
                y: (parent.height - self.preferred-height) / 2;
                text: "SYNTHOL";
                font-size: 14px;
                font-weight: 700;
                color: #e8eaf0;
            }
        }

        // Scrolls with the wheel if the content outgrows the window.
        // Not draggable, so knob and envelope drags never scroll it.
        body := Flickable {
            interactive: false;
            viewport-width: self.width;
            viewport-height: content.preferred-height;

            content := VerticalLayout {
                width: body.width;
                height: self.preferred-height;
                padding: 18px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 20px;
                    alignment: center;

                    Text {
                        text: "OUTPUT";
                        font-size: 10px;
                        font-weight: 700;
                        color: #9299a8;
                    }

                    OutputGainSlider {
                        width: 420px;
                        value <=> root.gain;
                        value-text: root.gain-text;
                        pressed => { root.gain-pressed(); }
                        changed(value) => { root.gain-changed(value); }
                        released => { root.gain-released(); }
                    }

                    Text {
                        text: "VOICES";
                        font-size: 10px;
                        font-weight: 700;
                        color: #9299a8;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;

                        Dropdown {
                            width: 72px;
                            options: ["Mono", "2", "3", "4", "5", "6", "7", "8"];
                            selected-index: root.voices - 1;
                            selected(index) => { root.voices-selected(index + 1); }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 16px;

                    VerticalLayout {
                        min-width: 0px;
                        preferred-width: 0px;
                        horizontal-stretch: 1;
                        alignment: start;
                        spacing: 4px;

                        HorizontalLayout {
                            height: 22px;
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "OSCILLATORS";
                                font-size: 10px;
                                font-weight: 700;
                                color: #9299a8;
                                vertical-alignment: center;
                            }

                            if root.oscillators.length < root.max-oscillators: TextButton {
                                text: "+ ADD";
                                clicked => {
                                    root.selected-oscillator = root.oscillators.length;
                                    root.oscillator-add();
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 0px;

                            HorizontalLayout {
                                padding-left: 8px;
                                spacing: 2px;
                                alignment: start;

                                for osc[index] in root.oscillators: TabButton {
                                    text: "OSC " + (index + 1);
                                    selected: index == root.current-oscillator;
                                    closable: root.oscillators.length > 1;
                                    clicked => { root.selected-oscillator = index; }
                                    close => {
                                        if root.selected-oscillator > index {
                                            root.selected-oscillator -= 1;
                                        }
                                        root.oscillator-remove(index);
                                    }
                                }
                            }

                            Rectangle {
                                background: #20232b;
                                border-radius: 8px;

                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 10px;

                                    HorizontalLayout {
                                        alignment: start;
                                        Dropdown {
                                            options: ["Sine", "Square", "Triangle", "Sawtooth"];
                                            selected-index: root.current-osc.waveform;
                                            selected(waveform) => { root.oscillator-selected(root.current-oscillator, waveform); }
                                        }
                                    }

                                    WaveformDisplay {
                                        horizontal-stretch: 1;
                                        height: 160px;
                                        waveform: root.current-osc.waveform;
                                        phase: root.current-osc.phase;
                                        cycle-path(waveform, phase, width, height) => {
                                            return root.oscillator-cycle-path(waveform, phase, width, height);
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: center;

                                        SynthKnob {
                                            value: root.current-osc.phase;
                                            label: "PHASE";
                                            // The value text ends well above the knob's
                                            // full height; trim it inside the panel.
                                            height: 88px;
                                            parameter-id: 2;
                                            value-text: root.current-osc.phase-text;
                                            changed(id, value) => { root.osc-changed(root.current-oscillator, id, value); }
                                            released(id) => { root.osc-released(root.current-oscillator, id); }
                                        }

                                        SynthKnob {
                                            value: root.current-osc.pitch;
                                            label: "PITCH";
                                            height: 88px;
                                            parameter-id: 0;
                                            value-text: root.current-osc.pitch-text;
                                            mod-target: 2 * root.current-oscillator;
                                            modulation: root.knob-mods[2 * root.current-oscillator];
                                            mod-drag-active: mod-handle.dragging;
                                            mod-drag-x: mod-handle.pointer-x;
                                            mod-drag-y: mod-handle.pointer-y;
                                            mod-drop-count: mod-handle.drop-count;
                                            mod-dropped(target) => { root.mod-assign(target); }
                                            changed(id, value) => { root.osc-changed(root.current-oscillator, id, value); }
                                            released(id) => { root.osc-released(root.current-oscillator, id); }
                                            mod-depth-changed(target, depth) => { root.mod-depth-changed(target, depth); }
                                            mod-depth-released(target) => { root.mod-depth-released(target); }
                                        }

                                        SynthKnob {
                                            value: root.current-osc.level;
                                            label: "LEVEL";
                                            height: 88px;
                                            parameter-id: 1;
                                            value-text: root.current-osc.level-text;
                                            mod-target: 2 * root.current-oscillator + 1;
                                            modulation: root.knob-mods[2 * root.current-oscillator + 1];
                                            mod-drag-active: mod-handle.dragging;
                                            mod-drag-x: mod-handle.pointer-x;
                                            mod-drag-y: mod-handle.pointer-y;
                                            mod-drop-count: mod-handle.drop-count;
                                            mod-dropped(target) => { root.mod-assign(target); }
                                            changed(id, value) => { root.osc-changed(root.current-oscillator, id, value); }
                                            released(id) => { root.osc-released(root.current-oscillator, id); }
                                            mod-depth-changed(target, depth) => { root.mod-depth-changed(target, depth); }
                                            mod-depth-released(target) => { root.mod-depth-released(target); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        min-width: 0px;
                        preferred-width: 0px;
                        horizontal-stretch: 1;
                        alignment: start;
                        spacing: 4px;

                        HorizontalLayout {
                            height: 22px;
                            spacing: 12px;
                            alignment: start;
                            Text {
                                text: "MODULATORS";
                                font-size: 10px;
                                font-weight: 700;
                                color: #9299a8;
                                vertical-alignment: center;
                            }
                            if root.lfo-count < root.max-lfos: TextButton {
                                text: "+ ADD";
                                clicked => {
                                    root.selected-lfo = root.lfo-count;
                                    root.lfo-add();
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 0px;

                            HorizontalLayout {
                                padding-left: 8px;
                                spacing: 2px;
                                alignment: start;
                                for index in root.lfo-count: TabButton {
                                    text: "LFO " + (index + 1);
                                    selected: index == root.current-lfo;
                                    closable: true;
                                    clicked => { root.selected-lfo = index; }
                                    close => {
                                        if root.selected-lfo > index {
                                            root.selected-lfo -= 1;
                                        }
                                        root.lfo-remove(index);
                                    }
                                }
                            }

                            if root.lfo-count == 0: Text {
                                text: "No modulators. Click + ADD to create an LFO.";
                                font-size: 10px;
                                color: #6f7685;
                                height: 32px;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                background: #20232b;
                                border-radius: 8px;
                                visible: root.lfo-count > 0;
                                min-height: 0px;
                                max-height: root.lfo-count > 0 ? 1000px : 0px;
                                vertical-stretch: 0;

                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 10px;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: start;

                                        Dropdown {
                                            options: ["Sine", "Square", "Triangle", "Sawtooth"];
                                            selected-index: root.lfo-shape;
                                            selected(index) => { root.lfo-shape-selected(index); }
                                        }

                                        Text {
                                            text: "MODE";
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: #9299a8;
                                            vertical-alignment: center;
                                        }

                                        Dropdown {
                                            width: 88px;
                                            options: ["Trigger", "Sync"];
                                            selected-index: root.lfo-mode;
                                            selected(index) => { root.lfo-mode-selected(index); }
                                        }
                                    }

                                    WaveformDisplay {
                                        horizontal-stretch: 1;
                                        height: 160px;
                                        waveform: root.lfo-shape;
                                        markers: root.lfo-markers;
                                        cycle-path(waveform, _, width, height) => {
                                            return root.lfo-cycle-path(waveform, width, height);
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: center;

                                        SynthKnob {
                                            height: 88px;
                                            value: root.lfo-rate;
                                            label: "RATE";
                                            value-text: root.lfo-rate-text;
                                            changed(_, value) => { root.lfo-rate-changed(value); }
                                            released(_) => { root.lfo-rate-released(); }
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 8px;

                                        HorizontalLayout {
                                            spacing: 12px;
                                            alignment: start;

                                            Text {
                                                text: "ROUTING";
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: #9299a8;
                                                vertical-alignment: center;
                                            }

                                            mod-handle := ModDragHandle { }

                                        }

                                        Text {
                                            text: "Drag onto PITCH, LEVEL, CUTOFF, Q or MIX\nAlt-drag for depth · Shift for fine";
                                            font-size: 9px;
                                            color: #6f7685;
                                        }

                                        Rectangle {
                                            height: 130px;

                                            for slot[index] in root.mod-slots: ModRouteRow {
                                                x: (parent.width - self.width) / 2;
                                                y: index * 34px;
                                                slot: slot;
                                                destinations: root.mod-destinations;
                                                destination-selected(destination) => { root.mod-destination-selected(index, destination); }
                                                amount-changed(amount) => { root.mod-amount-changed(index, amount); }
                                                amount-released => { root.mod-amount-released(index); }
                                                remove => { root.mod-remove(index); }
                                            }
                                        }
                                    }

                                }
                            }
                        }
                    }

                }

                HorizontalLayout {
                    spacing: 12px;

                    Text {
                        text: "FILTER";
                        font-size: 10px;
                        font-weight: 700;
                        color: #9299a8;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;

                        Dropdown {
                            options: ["Low Pass", "High Pass", "Band Pass"];
                            selected-index: root.filter-type;
                            selected(index) => { root.filter-type-selected(index); }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;

                        FilterResponseDisplay {
                            horizontal-stretch: 1;
                            filter-type: root.filter-type;
                            cutoff: root.filter-cutoff;
                            q: root.filter-q;
                            mix: root.filter-mix;
                            response-path(filter-type, cutoff, q, mix, width, height) => {
                                return root.filter-response-path(filter-type, cutoff, q, mix, width, height);
                            }
                        }
                    }

                    SynthKnob {
                        value: root.filter-cutoff;
                        label: "CUTOFF";
                        parameter-id: 0;
                        value-text: root.filter-cutoff-text;
                        mod-target: root.cutoff-mod-target;
                        modulation: root.knob-mods[root.cutoff-mod-target];
                        mod-drag-active: mod-handle.dragging;
                        mod-drag-x: mod-handle.pointer-x;
                        mod-drag-y: mod-handle.pointer-y;
                        mod-drop-count: mod-handle.drop-count;
                        mod-dropped(target) => { root.mod-assign(target); }
                        changed(id, value) => { root.filter-changed(id, value); }
                        released(id) => { root.filter-released(id); }
                        mod-depth-changed(target, depth) => { root.mod-depth-changed(target, depth); }
                        mod-depth-released(target) => { root.mod-depth-released(target); }
                    }

                    SynthKnob {
                        value: root.filter-q;
                        label: "Q";
                        parameter-id: 1;
                        value-text: root.filter-q-text;
                        mod-target: root.cutoff-mod-target + 1;
                        modulation: root.knob-mods[root.cutoff-mod-target + 1];
                        mod-drag-active: mod-handle.dragging;
                        mod-drag-x: mod-handle.pointer-x;
                        mod-drag-y: mod-handle.pointer-y;
                        mod-drop-count: mod-handle.drop-count;
                        mod-dropped(target) => { root.mod-assign(target); }
                        changed(id, value) => { root.filter-changed(id, value); }
                        released(id) => { root.filter-released(id); }
                        mod-depth-changed(target, depth) => { root.mod-depth-changed(target, depth); }
                        mod-depth-released(target) => { root.mod-depth-released(target); }
                    }

                    SynthKnob {
                        value: root.filter-mix;
                        label: "MIX";
                        parameter-id: 2;
                        value-text: root.filter-mix-text;
                        mod-target: root.cutoff-mod-target + 2;
                        modulation: root.knob-mods[root.cutoff-mod-target + 2];
                        mod-drag-active: mod-handle.dragging;
                        mod-drag-x: mod-handle.pointer-x;
                        mod-drag-y: mod-handle.pointer-y;
                        mod-drop-count: mod-handle.drop-count;
                        mod-dropped(target) => { root.mod-assign(target); }
                        changed(id, value) => { root.filter-changed(id, value); }
                        released(id) => { root.filter-released(id); }
                        mod-depth-changed(target, depth) => { root.mod-depth-changed(target, depth); }
                        mod-depth-released(target) => { root.mod-depth-released(target); }
                    }
                }

                AdsrEnvelopePanel {
                    width: 100%;
                    height: 360px;
                    attack <=> root.attack;
                    decay <=> root.decay;
                    sustain <=> root.sustain;
                    sustain-level: root.sustain-level;
                    release <=> root.release;
                    attack-text: root.attack-text;
                    decay-text: root.decay-text;
                    sustain-text: root.sustain-text;
                    release-text: root.release-text;
                    pressed(id) => { root.envelope-pressed(id); }
                    changed(id, value) => { root.envelope-changed(id, value); }
                    sustain-level-changed(value) => { root.envelope-sustain-level-changed(value); }
                    released(id) => { root.envelope-released(id); }
                }
            }
        }
    }

    if body.viewport-height > body.height: Rectangle {
        x: root.width - 6px;
        y: body.absolute-position.y + body.height * (-body.viewport-y) / body.viewport-height;
        width: 4px;
        height: body.height * body.height / body.viewport-height;
        border-radius: 2px;
        background: #424754;
    }

    // Follows the pointer while the LFO is dragged onto a knob; drawn last so
    // it sits above everything.
    if mod-handle.dragging: Rectangle {
        x: mod-handle.pointer-x - 7px;
        y: mod-handle.pointer-y - 7px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #f2b84d;
        border-width: 2px;
        border-color: #ffe2a8;
        opacity: 0.85;
    }
}
