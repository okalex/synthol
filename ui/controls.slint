// LFO modulation shown on a knob. `depth` is the summed route depth as a
// fraction of the knob's range; `live` is the modulated position.
export struct KnobModulation {
    routed: bool,
    depth: float,
    live: float,
    live-visible: bool,
}

// One arc segment around a knob, between normalized knob values `from` and
// `to` on the same 300deg sweep as the indicator.
component KnobArc inherits Path {
    in property <float> from;
    in property <float> to;
    in property <float> radius: 26;
    private property <angle> start-angle: 210deg + min(root.from, root.to) * 300deg;
    private property <angle> end-angle: 210deg + max(root.from, root.to) * 300deg;

    // Grown by one stroke width so the viewbox maps 1:1 onto the knob's
    // pixels, as in WaveformDisplay.
    x: -self.stroke-width / 2;
    y: -self.stroke-width / 2;
    width: 84px + self.stroke-width;
    height: 84px + self.stroke-width;
    viewbox-width: 84;
    viewbox-height: 84;
    stroke-width: 3px;
    visible: abs(root.to - root.from) > 0.002;

    MoveTo {
        x: 42 + root.radius * sin(root.start-angle);
        y: 40 - root.radius * cos(root.start-angle);
    }

    ArcTo {
        x: 42 + root.radius * sin(root.end-angle);
        y: 40 - root.radius * cos(root.end-angle);
        radius-x: root.radius;
        radius-y: root.radius;
        large-arc: root.end-angle - root.start-angle > 180deg;
        sweep: true;
    }
}

export component SynthKnob inherits Rectangle {
    in-out property <float> value: 0.0;
    in property <string> label;
    in property <string> value-text;
    in property <int> parameter-id;
    // LFO destination index this knob accepts drops for, or -1.
    in property <int> mod-target: -1;
    in property <KnobModulation> modulation;
    // An LFO drag in progress and the pointer in window coordinates.
    in property <bool> mod-drag-active;
    in property <length> mod-drag-x;
    in property <length> mod-drag-y;
    out property <bool> mod-drop-hover: root.mod-target >= 0 && root.mod-drag-active
        && root.mod-drag-x >= root.absolute-position.x
        && root.mod-drag-x < root.absolute-position.x + root.width
        && root.mod-drag-y >= root.absolute-position.y
        && root.mod-drag-y < root.absolute-position.y + 80px;
    callback pressed(int);
    callback changed(int, float);
    callback released(int);
    // Alt-drag on a routed knob edits its modulation depth (-1 to 1).
    callback mod-depth-changed(int, float);
    callback mod-depth-released(int);

    width: 84px;
    height: 112px;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        text: root.label;
        font-size: 10px;
        font-weight: 700;
        color: #9299a8;
        horizontal-alignment: center;
    }

    // Drop-target ring while an LFO drag is in progress.
    Rectangle {
        x: 13px;
        y: 11px;
        width: 58px;
        height: 58px;
        border-radius: 29px;
        border-width: root.mod-drop-hover ? 2px : 1px;
        border-color: #f2b84d;
        opacity: root.mod-drop-hover ? 1.0 : 0.4;
        visible: root.mod-target >= 0 && root.mod-drag-active;
    }

    Rectangle {
        x: 20px;
        y: 18px;
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: #292d36;
        border-width: 1px;
        border-color: #424754;
    }

    // The full swing of the LFO (both directions), with the positive
    // direction drawn brighter so the depth's sign is visible.
    if root.modulation.routed: KnobArc {
        from: clamp(root.value - root.modulation.depth, 0.0, 1.0);
        to: clamp(root.value + root.modulation.depth, 0.0, 1.0);
        stroke: #f2b84d;
        opacity: 0.3;
    }

    if root.modulation.routed: KnobArc {
        from: root.value;
        to: clamp(root.value + root.modulation.depth, 0.0, 1.0);
        stroke: #f2b84d;
    }

    if root.modulation.routed && root.modulation.live-visible: Rectangle {
        x: 42px + 26px * sin(210deg + root.modulation.live * 300deg) - 3.5px;
        y: 40px - 26px * cos(210deg + root.modulation.live * 300deg) - 3.5px;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: #ffe2a8;
    }

    Rectangle {
        // Clockwise sweep from 7 o'clock (210deg) to 5 o'clock (510deg).
        x: 42px + 16px * sin(210deg + root.value * 300deg) - 3px;
        y: 40px - 16px * cos(210deg + root.value * 300deg) - 3px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: #56a7ff;
    }

    Text {
        x: 0px;
        y: 70px;
        width: parent.width;
        text: root.value-text;
        font-size: 10px;
        color: #c6cad4;
        horizontal-alignment: center;
    }

    TouchArea {
        x: 12px;
        y: 12px;
        width: 60px;
        height: 60px;
        property <bool> gesture-active: false;
        property <bool> depth-gesture: false;
        property <float> start-value: 0.0;
        // Shift at press gives fine control.
        property <length> sensitivity: 100px;

        moved => {
            if self.gesture-active {
                if self.depth-gesture {
                    root.mod-depth-changed(
                        root.mod-target,
                        clamp(self.start-value - (self.mouse-y - self.pressed-y) / self.sensitivity, -1.0, 1.0));
                } else {
                    root.value = clamp(self.start-value - (self.mouse-y - self.pressed-y) / self.sensitivity, 0.0, 1.0);
                    root.changed(root.parameter-id, root.value);
                }
            }
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                self.gesture-active = true;
                self.sensitivity = event.modifiers.shift ? 1000px : 100px;
                self.depth-gesture = event.modifiers.alt && root.modulation.routed;
                if self.depth-gesture {
                    self.start-value = root.modulation.depth;
                } else {
                    self.start-value = root.value;
                    root.pressed(root.parameter-id);
                }
            } else if self.gesture-active
                    && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                self.gesture-active = false;
                if self.depth-gesture {
                    root.mod-depth-released(root.mod-target);
                } else {
                    root.released(root.parameter-id);
                }
            }
        }
    }
}

component EnvelopePoint inherits Rectangle {
    in property <float> value;
    in property <float> secondary-value: 0.0;
    in property <int> parameter-id;
    in property <int> secondary-parameter-id: -1;
    in property <length> sensitivity: 120px;
    in property <length> secondary-sensitivity: 120px;
    in property <bool> vertical;
    in property <bool> inverted;
    in property <bool> two-dimensional;
    callback pressed(int);
    callback changed(int, float);
    callback secondary-changed(float);
    callback released(int);

    width: 32px;
    height: 32px;
    background: transparent;

    Rectangle {
        x: 8px;
        y: 8px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #56a7ff;
        border-width: 2px;
        border-color: #e7f3ff;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        property <bool> gesture-active: false;
        property <float> start-value: 0.0;
        property <float> start-secondary-value: 0.0;
        property <int> selected-parameter: -1;
        property <length> start-global-x: 0px;
        property <length> start-global-y: 0px;

        moved => {
            if self.gesture-active {
                if root.two-dimensional {
                    let delta-x = self.mouse-x + self.absolute-position.x - self.start-global-x;
                    let delta-y = self.mouse-y + self.absolute-position.y - self.start-global-y;
                    let next-parameter = abs(delta-x) >= abs(delta-y)
                        ? root.parameter-id : root.secondary-parameter-id;
                    if next-parameter != self.selected-parameter {
                        if self.selected-parameter >= 0 {
                            root.released(self.selected-parameter);
                        }
                        self.selected-parameter = next-parameter;
                        if next-parameter >= 0 {
                            root.pressed(next-parameter);
                        }
                    }
                    if next-parameter == root.parameter-id {
                        root.changed(root.parameter-id, clamp(self.start-value + delta-x / root.sensitivity, 0.0, 1.0));
                    } else if next-parameter == root.secondary-parameter-id {
                        root.secondary-changed(clamp(self.start-secondary-value - delta-y / root.secondary-sensitivity, 0.0, 1.0));
                    }
                } else if root.vertical {
                    let global-y = self.mouse-y + self.absolute-position.y;
                    root.changed(root.parameter-id, clamp(self.start-value - (global-y - self.start-global-y) / root.sensitivity, 0.0, 1.0));
                } else {
                    let direction = root.inverted ? -1.0 : 1.0;
                    let global-x = self.mouse-x + self.absolute-position.x;
                    root.changed(root.parameter-id, clamp(self.start-value + direction * (global-x - self.start-global-x) / root.sensitivity, 0.0, 1.0));
                }
            }
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                self.gesture-active = true;
                self.start-value = root.value;
                self.start-secondary-value = root.secondary-value;
                self.start-global-x = self.mouse-x + self.absolute-position.x;
                self.start-global-y = self.mouse-y + self.absolute-position.y;
                if !root.two-dimensional {
                    self.selected-parameter = root.parameter-id;
                    root.pressed(root.parameter-id);
                }
            } else if self.gesture-active
                    && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                self.gesture-active = false;
                if self.selected-parameter >= 0 {
                    root.released(self.selected-parameter);
                    self.selected-parameter = -1;
                }
            }
        }
    }
}

export component AdsrEnvelopeGraph inherits Rectangle {
    in property <float> attack: 0.251;
    in property <float> decay: 0.549;
    in property <float> sustain-level: 0.501;
    in property <float> release: 0.631;
    callback pressed(int);
    callback changed(int, float);
    callback sustain-level-changed(float);
    callback released(int);

    private property <length> plot-left: 24px;
    private property <length> plot-right: self.width - 24px;
    private property <length> plot-top: 24px;
    private property <length> plot-bottom: self.height - 24px;
    private property <length> plot-height: self.plot-bottom - self.plot-top;
    private property <length> attack-x: self.plot-left + 0.03 * (self.plot-right - self.plot-left) + root.attack * 0.16 * (self.plot-right - self.plot-left);
    private property <length> decay-x: self.attack-x + 0.05 * (self.plot-right - self.plot-left) + root.decay * 0.18 * (self.plot-right - self.plot-left);
    private property <length> release-x: self.plot-right - (0.045 + root.release * 0.18) * (self.plot-right - self.plot-left);
    private property <length> sustain-y: self.plot-bottom - root.sustain-level * self.plot-height;
    private property <length> attack-sensitivity: 0.16 * (self.plot-right - self.plot-left);
    private property <length> decay-sensitivity: 0.18 * (self.plot-right - self.plot-left);
    private property <length> release-sensitivity: 0.18 * (self.plot-right - self.plot-left);

    background: #111319;
    border-radius: 5px;
    border-width: 1px;
    border-color: #30343d;

    Rectangle {
        x: root.plot-left;
        y: root.plot-top;
        width: root.plot-right - root.plot-left;
        height: 1px;
        background: #282c34;
    }
    Rectangle {
        x: root.plot-left;
        y: root.plot-top + root.plot-height / 3;
        width: root.plot-right - root.plot-left;
        height: 1px;
        background: #282c34;
    }
    Rectangle {
        x: root.plot-left;
        y: root.plot-top + root.plot-height * 2 / 3;
        width: root.plot-right - root.plot-left;
        height: 1px;
        background: #282c34;
    }
    Rectangle {
        x: root.plot-left;
        y: root.plot-bottom;
        width: root.plot-right - root.plot-left;
        height: 1px;
        background: #282c34;
    }

    Rectangle {
        x: root.plot-left;
        y: root.plot-top;
        width: 1px;
        height: root.plot-height;
        background: #242830;
    }
    Rectangle {
        x: root.plot-left + (root.plot-right - root.plot-left) / 4;
        y: root.plot-top;
        width: 1px;
        height: root.plot-height;
        background: #242830;
    }
    Rectangle {
        x: root.plot-left + (root.plot-right - root.plot-left) / 2;
        y: root.plot-top;
        width: 1px;
        height: root.plot-height;
        background: #242830;
    }
    Rectangle {
        x: root.plot-left + (root.plot-right - root.plot-left) * 3 / 4;
        y: root.plot-top;
        width: 1px;
        height: root.plot-height;
        background: #242830;
    }
    Rectangle {
        x: root.plot-right;
        y: root.plot-top;
        width: 1px;
        height: root.plot-height;
        background: #242830;
    }

    // The viewbox matches the graph's pixel size so path coordinates share the
    // EnvelopePoint coordinate space. Slint fits the viewbox into the element
    // minus the stroke width (offset by half of it), so the element is grown
    // by one stroke width to keep the mapping exactly 1:1.
    Path {
        x: -self.stroke-width / 2;
        y: -self.stroke-width / 2;
        width: root.width + self.stroke-width;
        height: root.height + self.stroke-width;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: #56a7ff;
        stroke-width: 3px;
        MoveTo {
            x: root.plot-left / 1px;
            y: root.plot-bottom / 1px;
        }
        LineTo {
            x: root.attack-x / 1px;
            y: root.plot-top / 1px;
        }
        LineTo {
            x: root.decay-x / 1px;
            y: root.sustain-y / 1px;
        }
        LineTo {
            x: root.release-x / 1px;
            y: root.sustain-y / 1px;
        }
        LineTo {
            x: root.plot-right / 1px;
            y: root.plot-bottom / 1px;
        }
    }

    EnvelopePoint {
        x: root.attack-x - 16px;
        y: root.plot-top - 16px;
        value: root.attack;
        parameter-id: 0;
        sensitivity: root.attack-sensitivity;
        pressed(id) => { root.pressed(id); }
        changed(id, value) => { root.changed(id, value); }
        released(id) => { root.released(id); }
    }

    EnvelopePoint {
        x: root.decay-x - 16px;
        y: root.sustain-y - 16px;
        value: root.decay;
        secondary-value: root.sustain-level;
        parameter-id: 1;
        secondary-parameter-id: 2;
        sensitivity: root.decay-sensitivity;
        secondary-sensitivity: root.plot-height;
        two-dimensional: true;
        pressed(id) => { root.pressed(id); }
        changed(id, value) => { root.changed(id, value); }
        secondary-changed(value) => { root.sustain-level-changed(value); }
        released(id) => { root.released(id); }
    }

    EnvelopePoint {
        x: root.release-x - 16px;
        y: root.sustain-y - 16px;
        value: root.release;
        parameter-id: 3;
        sensitivity: root.release-sensitivity;
        inverted: true;
        pressed(id) => { root.pressed(id); }
        changed(id, value) => { root.changed(id, value); }
        released(id) => { root.released(id); }
    }

}

export component AdsrEnvelopePanel inherits Rectangle {
    in-out property <float> attack: 0.251;
    in-out property <float> decay: 0.549;
    in-out property <float> sustain: 0.9;
    in-out property <float> sustain-level: 0.501;
    in-out property <float> release: 0.631;
    in property <string> attack-text: "10.0 ms";
    in property <string> decay-text: "500.0 ms";
    in property <string> sustain-text: "-6.0 dB";
    in property <string> release-text: "1000.0 ms";
    callback pressed(int);
    callback changed(int, float);
    callback sustain-level-changed(float);
    callback released(int);

    background: #20232b;
    border-radius: 8px;
    border-width: 1px;
    border-color: #30343d;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "OUTPUT ENVELOPE";
            font-size: 11px;
            font-weight: 700;
            color: #9299a8;
        }

        AdsrEnvelopeGraph {
            width: 100%;
            height: 190px;
            attack: root.attack;
            decay: root.decay;
            sustain-level: root.sustain-level;
            release: root.release;
            pressed(id) => { root.pressed(id); }
            changed(id, value) => { root.changed(id, value); }
            sustain-level-changed(value) => { root.sustain-level-changed(value); }
            released(id) => { root.released(id); }
        }

        HorizontalLayout {
            alignment: center;
            spacing: 18px;

            SynthKnob {
                value <=> root.attack;
                label: "ATTACK";
                value-text: root.attack-text;
                parameter-id: 0;
                pressed(id) => { root.pressed(id); }
                changed(id, value) => { root.changed(id, value); }
                released(id) => { root.released(id); }
            }

            SynthKnob {
                value <=> root.decay;
                label: "DECAY";
                value-text: root.decay-text;
                parameter-id: 1;
                pressed(id) => { root.pressed(id); }
                changed(id, value) => { root.changed(id, value); }
                released(id) => { root.released(id); }
            }

            SynthKnob {
                value <=> root.sustain;
                label: "SUSTAIN";
                value-text: root.sustain-text;
                parameter-id: 2;
                pressed(id) => { root.pressed(id); }
                changed(id, value) => { root.changed(id, value); }
                released(id) => { root.released(id); }
            }

            SynthKnob {
                value <=> root.release;
                label: "RELEASE";
                value-text: root.release-text;
                parameter-id: 3;
                pressed(id) => { root.pressed(id); }
                changed(id, value) => { root.changed(id, value); }
                released(id) => { root.released(id); }
            }
        }
    }
}

// Plots one cycle of an oscillator waveform from 0 to 360 degrees, starting
// at the normalized start `phase`. The shape is computed by the `cycle-path`
// callback (waveform, phase, width, height), which returns SVG path commands
// in pixel coordinates for the given plot size, so new or morphed waveforms
// need no UI changes.
// A vertical line across a WaveformDisplay at `position` (0 to 1) through the
// cycle. The newest marker is drawn solid and on top; others are faint.
export struct PositionMarker {
    position: float,
    visible: bool,
    newest: bool,
}

export component WaveformDisplay inherits Rectangle {
    in property <int> waveform: 0;
    in property <float> phase: 0.0;
    in property <[PositionMarker]> markers;
    pure callback cycle-path(int, float, float, float) -> string;

    private property <length> plot-left: 10px;
    private property <length> plot-right: self.width - 10px;
    private property <length> plot-top: 8px;
    private property <length> plot-bottom: self.height - 20px;
    private property <length> plot-width: self.plot-right - self.plot-left;
    private property <length> plot-height: self.plot-bottom - self.plot-top;

    width: 220px;
    height: 76px;
    background: #111319;
    border-radius: 5px;
    border-width: 1px;
    border-color: #30343d;

    for fraction in [0.0, 0.25, 0.5, 0.75, 1.0]: Rectangle {
        x: root.plot-left + root.plot-width * fraction;
        y: root.plot-top;
        width: 1px;
        height: root.plot-height;
        background: #242830;
    }

    Rectangle {
        x: root.plot-left;
        y: root.plot-top + root.plot-height / 2;
        width: root.plot-width;
        height: 1px;
        background: #343943;
    }

    // As in AdsrEnvelopeGraph, the element is grown by one stroke width so the
    // viewbox maps 1:1 onto the plot area's pixels.
    Path {
        x: root.plot-left - self.stroke-width / 2;
        y: root.plot-top - self.stroke-width / 2;
        width: root.plot-width + self.stroke-width;
        height: root.plot-height + self.stroke-width;
        viewbox-width: root.plot-width / 1px;
        viewbox-height: root.plot-height / 1px;
        commands: root.cycle-path(root.waveform, root.phase, root.plot-width / 1px, root.plot-height / 1px);
        stroke: #56a7ff;
        stroke-width: 2px;
    }

    // Two passes so the newest marker is drawn over the faint ones.
    for marker in root.markers: Rectangle {
        visible: marker.visible && !marker.newest;
        x: root.plot-left + root.plot-width * clamp(marker.position, 0.0, 1.0) - 1px;
        y: root.plot-top;
        width: 2px;
        height: root.plot-height;
        background: #f2b84d;
        opacity: 0.35;
    }

    for marker in root.markers: Rectangle {
        visible: marker.visible && marker.newest;
        x: root.plot-left + root.plot-width * clamp(marker.position, 0.0, 1.0) - 1px;
        y: root.plot-top;
        width: 2px;
        height: root.plot-height;
        background: #f2b84d;
    }

    for label[index] in ["0°", "180°", "360°"]: Text {
        x: root.plot-left + root.plot-width * index / 2 - self.preferred-width * index / 2;
        y: root.plot-bottom + 4px;
        text: label;
        font-size: 9px;
        color: #6f7685;
    }
}

// Magnitude response from 20 Hz to 20 kHz on a log axis, +24 dB at the top to
// -48 dB at the bottom. The path comes from Rust so it matches the DSP.
export component FilterResponseDisplay inherits Rectangle {
    in property <int> filter-type: 0;
    in property <float> cutoff: 1.0;
    in property <float> q: 0.5;
    pure callback response-path(int, float, float, float, float) -> string;

    private property <length> plot-left: 10px;
    private property <length> plot-right: self.width - 10px;
    private property <length> plot-top: 8px;
    private property <length> plot-bottom: self.height - 20px;
    private property <length> plot-width: self.plot-right - self.plot-left;
    private property <length> plot-height: self.plot-bottom - self.plot-top;

    width: 260px;
    height: 92px;
    background: #111319;
    border-radius: 5px;
    border-width: 1px;
    border-color: #30343d;
    clip: true;

    // 100 Hz, 1 kHz and 10 kHz: log10(f / 20) / log10(1000).
    for fraction in [0.233, 0.566, 0.9]: Rectangle {
        x: root.plot-left + root.plot-width * fraction;
        y: root.plot-top;
        width: 1px;
        height: root.plot-height;
        background: #242830;
    }

    // -24 dB grid line.
    Rectangle {
        x: root.plot-left;
        y: root.plot-top + root.plot-height * 2 / 3;
        width: root.plot-width;
        height: 1px;
        background: #242830;
    }

    // 0 dB.
    Rectangle {
        x: root.plot-left;
        y: root.plot-top + root.plot-height / 3;
        width: root.plot-width;
        height: 1px;
        background: #343943;
    }

    Path {
        x: root.plot-left - self.stroke-width / 2;
        y: root.plot-top - self.stroke-width / 2;
        width: root.plot-width + self.stroke-width;
        height: root.plot-height + self.stroke-width;
        viewbox-width: root.plot-width / 1px;
        viewbox-height: root.plot-height / 1px;
        commands: root.response-path(root.filter-type, root.cutoff, root.q, root.plot-width / 1px, root.plot-height / 1px);
        stroke: #56a7ff;
        stroke-width: 2px;
    }

    for label[index] in ["100", "1k", "10k"]: Text {
        x: root.plot-left + root.plot-width * (index == 0 ? 0.233 : index == 1 ? 0.566 : 0.9) - self.preferred-width / 2;
        y: root.plot-bottom + 4px;
        text: label;
        font-size: 9px;
        color: #6f7685;
    }

    Text {
        x: root.plot-left + 2px;
        y: root.plot-top + root.plot-height / 3 - self.preferred-height - 1px;
        text: "0 dB";
        font-size: 9px;
        color: #6f7685;
    }
}

// Drag-free select control. Like the other controls it has no FocusScope, so
// computer-MIDI keys keep reaching the host.
export component Dropdown inherits Rectangle {
    in property <[string]> options;
    in property <int> selected-index: 0;
    callback selected(int);

    width: 96px;
    height: 24px;
    border-radius: 4px;
    background: button-touch.has-hover ? #2f343e : #292d36;
    border-width: 1px;
    border-color: #424754;

    Text {
        x: 10px;
        text: root.options[root.selected-index];
        font-size: 11px;
        color: #e8eaf0;
        vertical-alignment: center;
    }

    Text {
        x: parent.width - 18px;
        text: "▾";
        font-size: 11px;
        color: #9299a8;
        vertical-alignment: center;
    }

    button-touch := TouchArea {
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: root.width;
        height: root.options.length * 22px + 4px;

        Rectangle {
            background: #20232b;
            border-radius: 4px;
            border-width: 1px;
            border-color: #424754;

            for option[index] in root.options: Rectangle {
                x: 2px;
                y: 2px + index * 22px;
                width: parent.width - 4px;
                height: 22px;
                border-radius: 3px;
                background: index == root.selected-index
                    ? #4d99f2
                    : (item-touch.has-hover ? #343943 : transparent);

                Text {
                    x: 8px;
                    text: option;
                    font-size: 11px;
                    color: index == root.selected-index ? #ffffff : #c6cad4;
                    vertical-alignment: center;
                }

                item-touch := TouchArea {
                    clicked => { root.selected(index); }
                }
            }
        }
    }
}

// One LFO routing slot as shown in the routing list.
export struct ModRouteSlot {
    // Index into the destination options; 0 is None.
    destination: int,
    // Normalized amount parameter: 0.5 is no modulation.
    amount: float,
    amount-text: string,
}

// Bipolar slider for a route's amount, drawn from the centre. Drags are
// relative (Shift for fine control); double-click resets to zero.
component BipolarSlider inherits Rectangle {
    in property <float> value: 0.5;
    in property <bool> enabled: true;
    callback changed(float);
    callback released();

    height: 24px;
    opacity: root.enabled ? 1.0 : 0.4;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: #343943;
    }

    Rectangle {
        x: parent.width * min(root.value, 0.5);
        y: (parent.height - self.height) / 2;
        width: parent.width * abs(root.value - 0.5);
        height: 4px;
        background: #f2b84d;
    }

    Rectangle {
        x: parent.width / 2 - 0.5px;
        y: (parent.height - self.height) / 2;
        width: 1px;
        height: 10px;
        background: #6f7685;
    }

    Rectangle {
        x: parent.width * root.value - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: #e8eaf0;
    }

    TouchArea {
        enabled: root.enabled;
        property <bool> gesture-active: false;
        property <float> start-value: 0.5;
        property <float> sensitivity: 1.0;

        moved => {
            if self.gesture-active {
                root.changed(clamp(self.start-value + (self.mouse-x - self.pressed-x) / parent.width * self.sensitivity, 0.0, 1.0));
            }
        }

        double-clicked => {
            root.changed(0.5);
            root.released();
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                self.gesture-active = true;
                self.start-value = root.value;
                self.sensitivity = event.modifiers.shift ? 0.1 : 1.0;
            } else if self.gesture-active
                    && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                self.gesture-active = false;
                root.released();
            }
        }
    }
}

export component ModRouteRow inherits Rectangle {
    in property <ModRouteSlot> slot;
    in property <[string]> destinations;
    callback destination-selected(int);
    callback amount-changed(float);
    callback amount-released();
    callback remove();

    private property <bool> routed: root.slot.destination > 0;

    width: 330px;
    height: 28px;
    border-radius: 4px;
    background: #1d2027;
    border-width: 1px;
    border-color: root.routed ? #4a4130 : #2a2e37;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 8px;
        alignment: start;

        VerticalLayout {
            alignment: center;

            Dropdown {
                width: 124px;
                height: 20px;
                options: root.destinations;
                selected-index: root.slot.destination;
                selected(index) => { root.destination-selected(index); }
            }
        }

        VerticalLayout {
            alignment: center;

            BipolarSlider {
                width: 100px;
                value: root.slot.amount;
                enabled: root.routed;
                changed(value) => { root.amount-changed(value); }
                released => { root.amount-released(); }
            }
        }

        Text {
            width: 58px;
            text: root.routed ? root.slot.amount-text : "";
            font-size: 10px;
            color: #f2b84d;
            vertical-alignment: center;
            horizontal-alignment: right;
        }

        Rectangle {
            width: 18px;
            border-radius: 3px;
            background: remove-touch.has-hover && root.routed ? #343943 : transparent;

            Text {
                text: "×";
                font-size: 13px;
                color: root.routed ? #9299a8 : #3b404b;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            remove-touch := TouchArea {
                enabled: root.routed;
                clicked => { root.remove(); }
            }
        }
    }
}

// Handle dragged from the LFO onto a knob to route the LFO to it. Reports the
// pointer in window coordinates while dragging.
export component ModDragHandle inherits Rectangle {
    out property <bool> dragging: false;
    out property <length> pointer-x;
    out property <length> pointer-y;
    callback dropped();

    width: 56px;
    height: 24px;
    border-radius: 12px;
    background: root.dragging || touch.has-hover ? #3a3222 : #292d36;
    border-width: 1px;
    border-color: #f2b84d;

    HorizontalLayout {
        padding-left: 9px;
        spacing: 6px;
        alignment: start;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: #f2b84d;
            }
        }

        Text {
            text: "MOD";
            font-size: 10px;
            font-weight: 700;
            color: #f2b84d;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.grab;

        moved => {
            if root.dragging {
                root.pointer-x = self.absolute-position.x + self.mouse-x;
                root.pointer-y = self.absolute-position.y + self.mouse-y;
            }
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.pointer-x = self.absolute-position.x + self.mouse-x;
                root.pointer-y = self.absolute-position.y + self.mouse-y;
                root.dragging = true;
            } else if root.dragging && event.kind == PointerEventKind.up {
                root.dropped();
                root.dragging = false;
            } else if event.kind == PointerEventKind.cancel {
                root.dragging = false;
            }
        }
    }
}
